# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# NUNCA suba o ".env" de verdade para o git — só este ".env.example".

PORT=3001

# Chave secreta que o totem envia no header "X-Totem-Key". Invente uma
# string longa e aleatória (ex: gere com `openssl rand -hex 32`) e use o
# MESMO valor em server-config.js no totem.
API_KEY=

# --- Microsoft Graph (app registrado no Azure AD / Entra ID) ---
# Passo a passo completo em server/README.md.
# Directory (tenant) ID do app (portal Azure > Entra ID > Registros de app)
AZURE_TENANT_ID=
# Application (client) ID do app
AZURE_CLIENT_ID=
# Client secret criado em "Certificados e segredos" do app (não é o Object ID!)
AZURE_CLIENT_SECRET=
# Caixa de e-mail que envia os certificados (precisa existir de verdade no
# tenant, e o app precisa ter a permissão de aplicativo Mail.Send consentida
# por um admin)
GRAPH_SENDER_EMAIL=certificados@suaempresa.com
